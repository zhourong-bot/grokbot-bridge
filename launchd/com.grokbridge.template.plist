<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.grokbridge.__JOB__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__BRIDGE__/__SCRIPT__</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>__BRIDGE__/inbox/new</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__BRIDGE__/logs/__JOB__.log</string>
  <key>StandardErrorPath</key><string>__BRIDGE__/logs/__JOB__.err</string>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
